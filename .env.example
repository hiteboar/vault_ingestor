# Folder where files will be stored (will be created if it doesn't exist)
STORAGE_DIR=./vault_storage

# Metadata log (JSON Lines)
META_LOG=./vault_storage/metadata.jsonl

# Maximum size per file in bytes (0 = no limit)
MAX_BYTES=0

# If false, we don't accept "photo" (because it might come compressed). Only "document" and "video".
ALLOW_COMPRESSED_PHOTOS=true

# "Default" base folder (within STORAGE_DIR)
DEFAULT_CONTEXT=default

# Public URL for access outside the local network (Cloudflare Tunnel, etc.)
# Example: https://vault-pccom.trycloudflare.com
PUBLIC_URL=

# Remote Access Configuration
# If true, the system will attempt to open a Cloudflare tunnel on startup.
ENABLE_REMOTE_ACCESS=false

# Cloudflare Token (Optional)
# If you have a persistent tunnel configured in your Cloudflare account, paste the token here.
# If left empty, a free temporary TryCloudflare tunnel will be used.
CLOUDFLARE_TOKEN=

# IA Agent Configuration
AGENT_LLM_PROVIDER=gemini
AGENT_LLM_MODEL=gemini-1.5-flash
AGENT_API_KEY=

# Git configuration for the Agent
AGENT_GIT_USER=VaultAgent
AGENT_GIT_EMAIL=agent@vault.local