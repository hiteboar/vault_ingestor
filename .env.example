# Carpeta donde guardar los archivos (se creará si no existe)
STORAGE_DIR=./vault_storage

# Log de metadatos (JSON Lines)
META_LOG=./vault_storage/metadata.jsonl

# Tamaño máximo por archivo en bytes (0 = sin límite)
MAX_BYTES=0

# Si es false, no aceptamos "photo" (porque puede venir comprimida). Solo "document" y "video".
ALLOW_COMPRESSED_PHOTOS=true

# Carpeta base "por defecto" (dentro de STORAGE_DIR)
DEFAULT_CONTEXT=default