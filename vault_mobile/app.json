{
  "expo": {
    "name": "Vault Mobile",
    "slug": "vault-mobile",
    "scheme": "vault-mobile",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      },
      "package": "com.pccom.vaultingestor",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "cb16824f-3f5e-4656-b8c9-42dd3a6ab373"
      }
    },
    "plugins": [
      [
        "expo-share-intent",
        {
          "iosShareExtensionTargetName": "VaultShareExtension",
          "androidIntentFilters": ["image", "video", "file"]
        }
      ]
    ]
  }
}
